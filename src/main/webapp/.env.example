# Copy this file to .env and fill in what you need.
# Never commit .env — it is gitignored. Everything here is optional;
# sane defaults are used when a value is unset.

# ── API keys (add at least one provider) ─────────────────────────────
# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: several Gemini keys, comma-separated, rotated on rate limits
# GEMINI_API_KEYS=key1,key2,key3

# OpenAI / GPT — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic / Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── Server ───────────────────────────────────────────────────────────
PORT=8080

# ── Provider endpoints (override for proxies / Azure / self-hosted) ──
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages
OLLAMA_URL=http://localhost:11434

# ── Default models (used when not chosen in the UI) ──────────────────
GEMINI_MODEL=gemini-3.6-flash
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-sonnet-4-5
OLLAMA_MODEL=qwen3-coder-128k:latest

# ── Generation parameters ────────────────────────────────────────────
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=16384
GEMINI_MAX_TOKENS=65536
ANTHROPIC_MAX_TOKENS=8192

# ── Timeouts (ms) & retries ──────────────────────────────────────────
AI_TIMEOUT_MS=180000
GEMINI_TIMEOUT_MS=180000
OLLAMA_TIMEOUT_MS=300000
GEMINI_RETRIES=3
GEMINI_RETRY_DELAY_MS=3000

# ── Ollama tuning ────────────────────────────────────────────────────
OLLAMA_NUM_CTX=32768
OLLAMA_NUM_PREDICT=16384
OLLAMA_REPEAT_PENALTY=1.1
